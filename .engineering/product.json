{
  "schema_version": 1,
  "applicable": true,
  "strategy_source": "docs/product.md",
  "change_depths": [
    "product_none",
    "product_local",
    "product_feature",
    "product_strategic"
  ],
  "default_depth": "product_local",
  "meaningful_product_change_depths": [
    "product_feature",
    "product_strategic"
  ],
  "risk_dimensions": [
    "value",
    "usability",
    "feasibility",
    "viability"
  ],
  "principles": {
    "outcomes_before_output": true,
    "evidence_before_commitment": true,
    "proportional_product_reasoning": true,
    "smallest_sufficient_solution_preferred": true,
    "discovery_may_conclude_do_not_build": true,
    "shipping_is_not_product_success": true
  },
  "success_layers": [
    "acceptance",
    "outcome",
    "product_impact"
  ],
  "project_constraints": {
    "training_free_v1": true,
    "zero_generated_answer_tokens_native_path": true,
    "reference_model": "Qwen/Qwen3.5-4B",
    "primary_scorer_hypothesis": "semantic_comparative_logodds",
    "answerability_first_class": true,
    "uncalibrated_scores_must_be_labeled": true,
    "deterministic_constraints_before_scoring": true,
    "reference_runtime": "llama.cpp",
    "reference_model_artifact_format": "GGUF",
    "reference_quantization": "Q4_K_M",
    "reference_gate_device": "CPU",
    "calibration_bound_to_exact_runtime_identity": true
  },
  "evidence": {
    "least_invasive_sufficient_evidence": true,
    "privacy_preserving_by_default": true,
    "material_assumptions_distinguished_from_facts": true
  },
  "handoffs": {
    "product_experience_skill": "skills/design-product-experience/SKILL.md",
    "product_shaping_skill": "skills/shape-product-change/SKILL.md",
    "engineering_workstream_skill": "skills/plan-workstream/SKILL.md"
  },
  "post_release_learning": {
    "required_when_material": true,
    "default_for_depths": [
      "product_feature",
      "product_strategic"
    ]
  }
}
